#!/usr/bin/env bash

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/glog"
NOTES_FILE="$DATA_DIR/glog.txt"

mkdir -p "$DATA_DIR"
touch "$NOTES_FILE"

trap 'echo ""; exit 0' INT

latest_20_formatted() {
    [ -s "$NOTES_FILE" ] || {
        printf "\033[2mNo entries yet.\033[0m\n"
        return
    }
    tail -n 20 "$NOTES_FILE" | awk -F '\t' '
        {
            lines[NR] = sprintf("\033[2m%s\033[0m  %s", $1, $2)
        }
        END {
            for (i = NR; i >= 1; i--) {
                print lines[i]
            }
        }
    '
}

# Shows top 20 most frequent notes from the past 60 minutes as a horizontal bar chart
past_hour_breakdown() {
    [ -s "$NOTES_FILE" ] || {
        gum style --foreground 245 "No notes yet."
        return
    }

    local cutoff
    cutoff=$(date -d "60 minutes ago" "+%Y-%m-%d %H:%M" 2>/dev/null || date -v -60M "+%Y-%m-%d %H:%M")

    gum style --bold --foreground 212 "Top 20 Notes (Past Hour, since $cutoff)"
    echo ""

    awk -F '\t' -v cutoff="$cutoff" '
        $1 >= cutoff && $2 != "" {
            counts[$2]++
        }
        END {
            n = 0
            for (k in counts) {
                n++
                items[n] = k
                vals[n] = counts[k]
            }
            if (n == 0) {
                print "\033[2mNo notes in the past hour.\033[0m"
                exit
            }

            # Sort descending by count (up to top 20)
            for (i = 1; i <= n; i++) {
                for (j = i + 1; j <= n; j++) {
                    if (vals[j] > vals[i]) {
                        tmp_v = vals[i]; vals[i] = vals[j]; vals[j] = tmp_v
                        tmp_k = items[i]; items[i] = items[j]; items[j] = tmp_k
                    }
                }
            }

            limit = (n < 20) ? n : 20
            max_val = vals[1]
            max_bar = 30

            # Find longest label among top 20 for clean alignment
            max_label = 4
            for (i = 1; i <= limit; i++) {
                len = length(items[i])
                if (len > 28) len = 28
                if (len > max_label) max_label = len
            }

            for (i = 1; i <= limit; i++) {
                label = items[i]
                if (length(label) > 28) {
                    label = substr(label, 1, 25) "..."
                }
                bar_len = int((vals[i] / max_val) * max_bar + 0.5)
                if (bar_len < 1) bar_len = 1

                bar = ""
                for (b = 1; b <= bar_len; b++) {
                    bar = bar "█"
                }

                printf "%-" max_label "s  \033[36m%-30s\033[0m %d\n", label, bar, vals[i]
            }
        }
    ' "$NOTES_FILE"
}

redraw_main() {
    printf "\033[H\033[2J"
    printf "\033[2mEmpty Enter = top 20 chart • :clear = wipe log • :q/Ctrl+C = quit • %s\033[0m\n\n" "$NOTES_FILE"
    latest_20_formatted
    echo ""
}

redraw_main

while true; do
    NOTE=$(gum input --placeholder "New note...") || exit 0

    case "$NOTE" in
        ":clear")
            if gum confirm "Clear all logs in $NOTES_FILE?"; then
                : > "$NOTES_FILE"
            fi
            redraw_main
            ;;
        ":q"|":quit")
            exit 0
            ;;
        "")
            printf "\033[H\033[2J"
            past_hour_breakdown
            echo ""
            gum style --foreground 245 "Press Enter to return..."
            read -r _ </dev/tty || exit 0
            redraw_main
            ;;
        *)
            CLEAN_NOTE=$(printf '%s' "$NOTE" | tr '\t\r\n' '   ')
            printf "%s\t%s\n" "$(date "+%Y-%m-%d %H:%M")" "$CLEAN_NOTE" >> "$NOTES_FILE"
            redraw_main
            ;;
    esac
done
