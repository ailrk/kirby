#!/usr/bin/env bash

# Exit if gum is not installed
if ! command -v gum &> /dev/null; then
    echo "Error: 'gum' is not installed. Install it via Homebrew, Go, or your package manager."
    exit 1
fi

TARGET_DIR="${1:-$HOME}"

# --- Centralized Ignore List for Git Scanning ---
IGNORED_DIRS=(
    ".cache"
    ".local"
    ".config"
    "node_modules"
    ".Trash"
    "Library"
    "venv"
    ".venv"
)

# --- Find Git Repos (prints one .git path per line) ---
find_git_repos() {
    local prune_args=()
    local d
    for d in "${IGNORED_DIRS[@]}"; do
        [ ${#prune_args[@]} -gt 0 ] && prune_args+=("-o")
        prune_args+=("-name" "$d")
    done

    find "$TARGET_DIR" \
        \( "${prune_args[@]}" \) -prune \
        -o -type d -name ".git" -print -prune 2>/dev/null
}

# --- Run find_git_repos under a spinner ---
get_repos() {
    gum spin --spinner dot --title "Locating Git repositories..." --show-output -- \
        bash -c "$(declare -p IGNORED_DIRS TARGET_DIR); $(declare -f find_git_repos); find_git_repos"
}

# --- Feature 1: Git Repo Scanner (Uncommitted Changes) ---
scan_git_repos() {
    trap 'return 0' INT

    gum style --border normal --padding "1 2" --border-foreground 212 \
        "🔍 Scanning $TARGET_DIR for Git repositories..."

    local repos
    repos=$(get_repos)

    if [ -z "$repos" ]; then
        gum style --foreground 212 "No Git repositories found in $TARGET_DIR."
        trap - INT
        return
    fi

    local dirty_repos=()
    local repo repo_dir

    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        repo_dir=$(dirname "$repo")
        if [ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null </dev/null)" ]; then
            dirty_repos+=("$repo_dir")
        fi
    done <<< "$repos"

    if [ ${#dirty_repos[@]} -eq 0 ]; then
        gum style --foreground 46 --bold "✨ All Git repositories are clean! No uncommitted changes found."
        trap - INT
        return
    fi

    gum style --foreground 214 --bold "⚠️ Found ${#dirty_repos[@]} repository/repositories with uncommitted changes:"

    local selected_repo
    selected_repo=$(printf '%s\n' "${dirty_repos[@]}" | gum filter --height 12 --placeholder "Select a repository to check status..." || true)

    if [ -n "$selected_repo" ]; then
        clear
        gum style --border rounded --padding "1 2" --border-foreground 39 "📂 Repository: $selected_repo"
        echo ""
        git -C "$selected_repo" status
        echo ""

        if gum confirm "Would you like to open a shell here?"; then
            gum style --foreground 212 "Navigating to $selected_repo..."
            cd "$selected_repo" && exec "$SHELL"
        fi
    fi

    trap - INT
}


# --- Feature 3: Disk Usage Checker ---
check_disk_usage() {
    trap 'return 0' INT

    gum style --border normal --padding "1 2" --border-foreground 39 \
        "💾 Analyzing disk usage in $TARGET_DIR..."

    local disk_data
    disk_data=$(gum spin --spinner globe --title "Calculating disk sizes..." --show-output -- \
        bash -c 'du -h -d 2 "$1" 2>/dev/null | sort -hr | head -n 25' _ "$TARGET_DIR")

    if [ -z "$disk_data" ]; then
        gum style --foreground 212 "Could not read disk usage for $TARGET_DIR."
        trap - INT
        return
    fi

    gum style --border rounded --padding "1 2" --border-foreground 212 "📊 Top Disk Usage in $TARGET_DIR (Depth 2)"
    echo "$disk_data"
    echo ""

    trap - INT
}

# --- Top-Level Interactive Menu ---
while true; do
    clear
    gum style --border double --padding "1 3" --border-foreground 212 --align center \
        "🛠️ GCHECK - System Checker 🛠️" \
        "Target Path: $TARGET_DIR"

    echo ""
    choice=$(gum choose \
        "📂 Check Git Repos for Uncommitted Changes" \
        "💾 Check Disk Usage" \
        "🚪 Exit" || echo "🚪 Exit")

    case "$choice" in
        "📂 Check Git Repos for Uncommitted Changes")
            scan_git_repos
            ;;
        "💾 Check Disk Usage")
            check_disk_usage
            ;;
        *)
            gum style --foreground 39 "Goodbye!"
            exit 0
            ;;
    esac
done
