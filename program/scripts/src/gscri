#!/usr/bin/env bash

# Capture the exact directory from which script-mgr was launched
LAUNCH_DIR="$(pwd)"

# Directory configuration
BASE_DIR="${SCRIPT_MGR_DIR:-$HOME/.config/script-mgr}"
SCRIPTS_DIR="$BASE_DIR/scripts"
LOGS_DIR="$BASE_DIR/logs"
META_DIR="$BASE_DIR/meta"
COMMENTS_DIR="$BASE_DIR/comments"

# Ensure directories exist
mkdir -p "$SCRIPTS_DIR" "$LOGS_DIR" "$META_DIR" "$COMMENTS_DIR"

# Ensure dependencies are installed
if ! command -v gum &> /dev/null; then
    echo "Error: 'gum' is not installed. Please install it first (https://github.com/charmbracelet/gum)."
    exit 1
fi

pause_key() {
    echo ""
    gum style --foreground 240 "Press any key to return to menu..."
    read -n 1 -s -r
}

# Global declarations for script menu mapping
declare -a SCRIPT_DISPLAY_LIST
declare -A SCRIPT_MAP

# Helper function to generate sorted script choices with timestamps
get_script_menu_data() {
    local script_files=("$SCRIPTS_DIR"/*)
    if [[ ! -e "${script_files[0]}" ]]; then
        return 1
    fi

    SCRIPT_DISPLAY_LIST=()
    unset SCRIPT_MAP
    declare -g -A SCRIPT_MAP

    local temp_entries=()

    for filepath in "${script_files[@]}"; do
        [[ -f "$filepath" ]] || continue
        local filename=$(basename "$filepath")
        local meta_file="$META_DIR/${filename}.meta"
        local timestamp="0"

        if [[ -f "$meta_file" ]]; then
            local val=""
            val=$(grep '^CREATED_AT=' "$meta_file" | cut -d'=' -f2- | tr -d '"')
            [[ -n "$val" ]] && timestamp="$val"
        fi

        # Fallback to file modification time if meta timestamp is missing
        if [[ "$timestamp" == "0" ]]; then
            timestamp=$(stat -c %Y "$filepath" 2>/dev/null || stat -f %m "$filepath" 2>/dev/null || echo "0")
        fi

        temp_entries+=("$timestamp:$filename")
    done

    if [[ ${#temp_entries[@]} -eq 0 ]]; then
        return 1
    fi

    # Sort descending by timestamp (newest first)
    local sorted_entries
    sorted_entries=$(printf '%s\n' "${temp_entries[@]}" | sort -t: -k1,1nr)

    while IFS=':' read -r ts filename; do
        [[ -z "$filename" ]] && continue

        # Format epoch timestamp to YYYY-MM-DD HH:MM:SS (supports GNU and BSD/macOS)
        local formatted_date=""
        if date -d "@$ts" "+%Y-%m-%d %H:%M:%S" &>/dev/null; then
            formatted_date=$(date -d "@$ts" "+%Y-%m-%d %H:%M:%S")
        elif date -r "$ts" "+%Y-%m-%d %H:%M:%S" &>/dev/null; then
            formatted_date=$(date -r "$ts" "+%Y-%m-%d %H:%M:%S")
        else
            formatted_date="$ts"
        fi

        local display_str="$formatted_date - $filename"
        SCRIPT_DISPLAY_LIST+=("$display_str")
        SCRIPT_MAP["$display_str"]="$filename"
    done <<< "$sorted_entries"

    return 0
}

# Function to create a new script
create_script() {
    gum style --foreground 212 --bold "Create a New Script"

    # Ask for filename
    local filename
    filename=$(gum input --placeholder "script_name.py or script_name.sh")
    if [[ -z "$filename" ]]; then
        gum style --foreground 196 "Operation cancelled (no filename provided)."
        pause_key
        return
    fi

    local filepath="$SCRIPTS_DIR/$filename"
    local meta_file="$META_DIR/${filename}.meta"
    local current_epoch=$(date +%s)

    # Ask if execution location matters
    gum style --foreground 212 "Does the execution location matter for this script?"
    if gum confirm "Always execute in creation directory ($LAUNCH_DIR)?"; then
        {
            echo "WORK_DIR=\"$LAUNCH_DIR\""
            echo "CREATED_AT=\"$current_epoch\""
        } > "$meta_file"
        gum style --foreground 212 "Bound script execution directory to: $LAUNCH_DIR"
    else
        {
            echo "WORK_DIR=\"\""
            echo "CREATED_AT=\"$current_epoch\""
        } > "$meta_file"
        gum style --foreground 240 "Script will execute wherever script-mgr is launched from."
    fi

    # Add default shebang if file doesn't exist
    if [[ ! -f "$filepath" ]]; then
        case "$filename" in
            *.py)
                echo "#!/usr/bin/env python3" > "$filepath"
                ;;
            *.sh|*.bash)
                echo "#!/usr/bin/env bash" > "$filepath"
                ;;
            *.rb)
                echo "#!/usr/bin/env ruby" > "$filepath"
                ;;
            *.js)
                echo "#!/usr/bin/env node" > "$filepath"
                ;;
        esac
        chmod +x "$filepath"
    fi

    # Spawn nvim
    nvim "$filepath"
    gum style --foreground 46 "Saved script to $filepath"
    pause_key
}

# Function to run an existing script
run_script() {
    if ! get_script_menu_data; then
        gum style --foreground 214 "No scripts found. Create one first!"
        pause_key
        return
    fi

    # Select script using gum choose
    local selected_display
    selected_display=$(printf '%s\n' "${SCRIPT_DISPLAY_LIST[@]}" | gum choose --header "Select script to run:")
    if [[ -z "$selected_display" ]]; then
        return
    fi

    local selected_file="${SCRIPT_MAP["$selected_display"]}"
    local filepath="$SCRIPTS_DIR/$selected_file"
    local meta_file="$META_DIR/${selected_file}.meta"

    # Optional CLI arguments input
    local args
    args=$(gum input --placeholder "Optional CLI arguments (e.g. --verbose input.txt)")

    # Read bound target directory if recorded
    local WORK_DIR=""
    if [[ -f "$meta_file" ]]; then
        source "$meta_file"
    fi

    # Determine execution directory: bound directory vs current launch directory
    local exec_dir="$LAUNCH_DIR"
    if [[ -n "$WORK_DIR" ]]; then
        if [[ -d "$WORK_DIR" ]]; then
            exec_dir="$WORK_DIR"
            gum style --foreground 212 "Changing directory to bound location: $exec_dir"
        else
            gum style --foreground 196 "Warning: Bound directory '$WORK_DIR' no longer exists. Running in launch directory: $LAUNCH_DIR"
        fi
    fi

    # Execute script & log output
    local timestamp
    timestamp=$(date +"%Y%m%d_%H%M%S")
    local logfile="$LOGS_DIR/${selected_file}_${timestamp}.log"

    gum style --foreground 212 "Executing: $selected_file $args"
    echo "=== Execution log for $selected_file $args ===" > "$logfile"
    echo "=== Executed in: $exec_dir ===" >> "$logfile"
    echo "=== Date: $(date) ===" >> "$logfile"
    echo "===============================================" >> "$logfile"
    echo "" >> "$logfile"

    # Execute script inside the target directory
    (
        cd "$exec_dir" || exit 1
        eval "\"$filepath\" $args"
    ) 2>&1 | tee -a "$logfile"

    local exit_code=${PIPESTATUS[0]}

    echo "" >> "$logfile"
    echo "=== Finished with exit code: $exit_code ===" >> "$logfile"

    echo ""
    if [[ $exit_code -eq 0 ]]; then
        gum style --foreground 46 "Script executed successfully! Log saved to $logfile"
    else
        gum style --foreground 196 "Script failed (Exit Code: $exit_code). Log saved to $logfile"
    fi

    pause_key
}

# Function to edit an existing script
edit_script() {
    if ! get_script_menu_data; then
        gum style --foreground 214 "No scripts found."
        pause_key
        return
    fi

    local selected_display
    selected_display=$(printf '%s\n' "${SCRIPT_DISPLAY_LIST[@]}" | gum choose --header "Select script to edit:")
    if [[ -n "$selected_display" ]]; then
        local selected_file="${SCRIPT_MAP["$selected_display"]}"
        nvim "$SCRIPTS_DIR/$selected_file"
    fi
}

# Function to write or edit comments/notes for a script
comment_script() {
    if ! get_script_menu_data; then
        gum style --foreground 214 "No scripts found."
        pause_key
        return
    fi

    local selected_display
    selected_display=$(printf '%s\n' "${SCRIPT_DISPLAY_LIST[@]}" | gum choose --header "Select script to comment/note:")
    if [[ -z "$selected_display" ]]; then
        return
    fi

    local selected_file="${SCRIPT_MAP["$selected_display"]}"
    local comment_file="$COMMENTS_DIR/${selected_file}.txt"

    gum style --foreground 212 "Opening notes for $selected_file..."
    nvim "$comment_file"
    gum style --foreground 46 "Saved notes for $selected_file"
    pause_key
}

# Function to delete a script, its notes, metadata, and logs
delete_script() {
    if ! get_script_menu_data; then
        gum style --foreground 214 "No scripts found to delete."
        pause_key
        return
    fi

    local selected_display
    selected_display=$(printf '%s\n' "${SCRIPT_DISPLAY_LIST[@]}" | gum choose --header "Select script to delete:")
    if [[ -z "$selected_display" ]]; then
        return
    fi

    local selected_file="${SCRIPT_MAP["$selected_display"]}"

    gum style --foreground 196 --bold "Are you sure you want to delete '$selected_file'?"
    if gum confirm "This will remove the script, its notes, directory metadata, and associated execution logs."; then
        rm -f "$SCRIPTS_DIR/$selected_file"
        rm -f "$META_DIR/${selected_file}.meta"
        rm -f "$COMMENTS_DIR/${selected_file}.txt"
        rm -f "$LOGS_DIR/${selected_file}_"*.log
        gum style --foreground 46 "Successfully deleted $selected_file and its associated data/logs."
    else
        gum style --foreground 240 "Deletion cancelled."
    fi
    pause_key
}

# Function to view past execution logs with formatted timestamps
view_logs() {
    local logs=("$LOGS_DIR"/*)
    if [[ ! -e "${logs[0]}" ]]; then
        gum style --foreground 214 "No log history found."
        pause_key
        return
    fi

    local display_list=()
    declare -A log_map

    while IFS= read -r log_file; do
        [[ -z "$log_file" ]] && continue
        local filename=$(basename "$log_file")
        if [[ "$filename" =~ ^(.+)_([0-9]{8})_([0-9]{6})\.log$ ]]; then
            local s_name="${BASH_REMATCH[1]}"
            local date_part="${BASH_REMATCH[2]}"
            local time_part="${BASH_REMATCH[3]}"
            local formatted_date="${date_part:0:4}-${date_part:4:2}-${date_part:6:2} ${time_part:0:2}:${time_part:2:2}:${time_part:4:2}"
            local display_str="$formatted_date - $s_name"
            display_list+=("$display_str")
            log_map["$display_str"]="$filename"
        else
            display_list+=("$filename")
            log_map["$filename"]="$filename"
        fi
    done < <(ls -1t "$LOGS_DIR")

    local selected_display
    selected_display=$(printf '%s\n' "${display_list[@]}" | gum choose --header "Select an execution log to view:")
    if [[ -n "$selected_display" ]]; then
        local target_file="${log_map["$selected_display"]}"
        gum pager < "$LOGS_DIR/$target_file"
    fi
}

# Main Interactive Menu
main_menu() {
    while true; do
        clear
        gum style \
            --border double \
            --margin "1 2" \
            --padding "1 2" \
            --border-foreground 212 \
            "One-Off Script Manager"

        ACTION=$(gum choose \
            "Run Script" \
            "Create New Script" \
            "Edit Existing Script" \
            "Comment" \
            "Delete Script" \
            "View Past Output Logs" \
            "Exit")

        case "$ACTION" in
            "Run Script")
                run_script
                ;;
            "Create New Script")
                create_script
                ;;
            "Edit Existing Script")
                edit_script
                ;;
            "Comment")
                comment_script
                ;;
            "Delete Script")
                delete_script
                ;;
            "View Past Output Logs")
                view_logs
                ;;
            "Exit"|"")
                gum style --foreground 212 "Goodbye!"
                exit 0
                ;;
        esac
    done
}

main_menu
