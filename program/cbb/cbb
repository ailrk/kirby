#!/usr/bin/env bash

cmd() {
  local file="$HOME/.config/cbb/cbb.yaml"

  if [ ! -f "$file" ]; then
    echo "Error: $file does not exist." >&2
    return 1
  fi

  local selected
  selected=$(yq -r '
  to_entries[] |
      .key as $t |
      (.value.description // "No description") as $d |
      (.value.commands // [])[] |
      [$t, $d, "\u001b[32m" + . + "\u001b[0m", .] |
      @tsv
  ' "$file" | fzf \
      --ansi \
      --delimiter='\t' \
      --with-nth=1,3 \
      --preview='echo -e "\033[1;34mDescription:\033[0m {2}\n\n\033[1;32mCommand:\033[0m {3}"' \
      --preview-window=bottom:3:wrap)

  [ -z "$selected" ] && return

  # Extract column 4 (0-indexed position 3) instantly using `choose`
  echo "$selected" | choose -f $'\t' 3

}

cmd
